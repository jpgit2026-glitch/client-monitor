generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DIRECTOR
  ADMIN
  ACCOUNTING
  LIAISON
  IT
  HR
}

enum WorkRole {
  ACCOUNTING
  LIAISON
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  WAITING_FOR_CLIENT
  FOR_REVIEW
  FOR_BILLING
  FOR_FILING
  COMPLETED
  CANCELLED
}

enum Priority {
  URGENT
  HIGH
  NORMAL
  LOW
}

model Employee {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String
  pinHash      String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  tasks            Task[]        @relation("AssignedTo")
  assignedTasks    Task[]        @relation("TaskAssignees")
  handlingTasks    Task[]        @relation("CurrentHandler")
  createdTasks     Task[]        @relation("CreatedBy")
  activityLogs   ActivityLog[]
  comments       TaskComment[]
  mentionedIn    TaskComment[] @relation("CommentMentions")
  commentReads   TaskCommentRead[]
  handledClients Client[]      @relation("ClientHandlers")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("ACTIVE")
  notes     String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  tasks    Task[]
  handlers Employee[] @relation("ClientHandlers")
}

model Task {
  id             String     @id @default(cuid())
  title          String
  clientId       String
  client         Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedToId      String?
  assignedTo        Employee?  @relation("AssignedTo", fields: [assignedToId], references: [id])
  currentHandlerId  String?
  currentHandler    Employee?  @relation("CurrentHandler", fields: [currentHandlerId], references: [id])
  createdById       String?
  createdBy         Employee?  @relation("CreatedBy", fields: [createdById], references: [id])
  workRole       WorkRole
  status         TaskStatus @default(PENDING)
  priority       Priority   @default(NORMAL)
  progressPct    Int        @default(0)
  dueDate        DateTime?
  notes          String?
  filePath       String?
  followUpDate   DateTime?
  result         String?
  dependsOnId    String?
  dependsOn      Task?      @relation("Dependency", fields: [dependsOnId], references: [id])
  dependents     Task[]     @relation("Dependency")
  assignees      Employee[] @relation("TaskAssignees")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  activityLogs ActivityLog[]
  comments     TaskComment[]
  commentReads TaskCommentRead[]

  @@index([clientId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
}

model TaskComment {
  id         String     @id @default(cuid())
  taskId     String
  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee   @relation(fields: [employeeId], references: [id])
  message    String
  mentions   Employee[] @relation("CommentMentions")
  createdAt  DateTime   @default(now())

  @@index([taskId])
}

model ActivityLog {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  action     String
  createdAt  DateTime @default(now())

  @@index([taskId])
}

model TaskCommentRead {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  lastReadAt DateTime @default(now())

  @@unique([taskId, employeeId])
  @@index([employeeId])
}
